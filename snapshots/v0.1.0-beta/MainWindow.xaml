<Window x:Class="HDs2_SDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDs2_SDK"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 素雅灰白圆形按键样式（启/停/设 等独立按钮） -->
        <Style x:Key="FlatRoundBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect Color="#77142538" BlurRadius="7" ShadowDepth="2" Opacity="0.65"/>
                            </Grid.Effect>
                            <Border x:Name="bd" Background="#FFE5E7EB" BorderBrush="#FFA8B4C8" BorderThickness="1" CornerRadius="22"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="2"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background" Value="#FF9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- 中间磨砂圆角面板（深色渐变版） -->
        <Border Width="400" Height="300"
                CornerRadius="40"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2A2D35" Offset="0"/>
                    <GradientStop Color="#FF15171C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#22000000"
                                  BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.8"/>
            </Border.Effect>
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="43*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：数据灯（待机/运行）+ 高低速状态显示，分隔线靠右（贴近表盘） -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,10" Height="22">
                            <Ellipse x:Name="LedStatus" Width="20" Height="20" Fill="#9CA3AF"/>
                            <TextBlock x:Name="LblStatus" Text="待机" Margin="8,0,0,0" Foreground="#E5E7EB" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" Width="54"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10" Height="22">
                            <Ellipse x:Name="LedSpeed" Width="20" Height="20" Fill="#4A90E2"/>
                            <TextBlock x:Name="LblSpeed" Text="低速" Margin="8,0,0,0" Foreground="#E5E7EB" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" Width="54"/>
                        </StackPanel>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Width="1" Height="96" Background="#664A90E2"/>
                </Grid>

                <!-- 中：表盘与数码管 Z 轴分层（数码管下层，表盘上层，刻度不被遮挡） -->
                <Grid Grid.Column="1" Width="120" Height="120" VerticalAlignment="Center" Margin="14,0">
                    <!-- 下层：数码管深色底板 -->
                    <Border Width="96" Height="30" CornerRadius="8" Background="#FF0A1A0E"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 下层：数码管 -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.LayoutTransform>
                            <ScaleTransform ScaleX="0.32" ScaleY="0.32"/>
                        </StackPanel.LayoutTransform>
                        <local:SevenSegmentDigit x:Name="Digit1" Digit="0"/>
                        <local:SevenSegmentDigit x:Name="Digit2" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit3" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit4" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit5" Digit="0" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- 上层：表盘（透明背景，ring/刻度/圆球在最上层，从不被遮挡） -->
                    <Canvas x:Name="GaugeCanvas" Width="120" Height="120"/>
                </Grid>

                <!-- 右：分隔线靠左（贴近表盘），正反滑动开关居中 -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="1" Height="96" Background="#664A90E2"/>
                    <Grid x:Name="DirSwitch" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Width="84" Height="34" MouseLeftButtonDown="Dir_Click" Cursor="Hand">
                        <!-- 轨道 -->
                        <Border CornerRadius="17" Background="#33000000"/>
                        <!-- 两端标记 -->
                        <TextBlock Text="正" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="反" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- 滑块（带正/反文字，滑动） -->
                        <Border x:Name="DirKnob" Width="44" Height="28" CornerRadius="14" Background="#4A90E2"
                                HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DirKnobX" X="0"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="TxtDir" Text="正" Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 分界线 -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#334A90E2" Margin="0,10"/>

                <!-- 底部：启 / 停 / 转速输入 / 设 -->
                <Grid Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnStart" Style="{StaticResource FlatRoundBtn}" Content="启" HorizontalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnStop" Style="{StaticResource FlatRoundBtn}" Content="停" HorizontalAlignment="Center"/>
                    <!-- 转速输入组：时钟式微嵌入凹槽（仅显示数字） -->
                    <Grid Grid.Column="2" Height="38" Width="108" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 凹槽底（深于面板，内嵌感） -->
                        <Border Background="#0C0E13" CornerRadius="6"/>
                        <!-- 左上深阴影（凹槽内壁背光） -->
                        <Border CornerRadius="6" BorderBrush="#05070A" BorderThickness="1,1,0,0"/>
                        <!-- 右下浅受光（凹槽内壁迎光） -->
                        <Border CornerRadius="6" BorderBrush="#3A4453" BorderThickness="0,0,1,1"/>
                        <TextBox x:Name="TxtSpeed" BorderThickness="0" Background="Transparent"
                                 Foreground="#D5E0F0" FontSize="16" FontWeight="SemiBold" CaretBrush="#4A90E2"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Margin="10,0" KeyDown="TxtSpeed_KeyDown"/>
                    </Grid>
                    <Button Grid.Column="3" x:Name="BtnSetSpeed" Style="{StaticResource FlatRoundBtn}" Content="设" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
