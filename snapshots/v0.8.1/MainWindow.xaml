<Window x:Class="HDs2_SDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDs2_SDK"
        mc:Ignorable="d"
        Title="HDs2-SDK" Height="230" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- 面板：圆角18，填充 #0E1422 + 蓝色径向高光，双层描边，柔和投影（按规格 §14） -->
        <Border x:Name="MainPanel" Width="370" Height="200"
                CornerRadius="18"
                BorderBrush="Transparent"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.45" RadiusY="0.4" Opacity="0.92">
                    <GradientStop Color="#0E1422" Offset="0"/>
                    <GradientStop Color="#0E1422" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <!-- 面板投影：光源左上 → 阴影投向右下（左上浅右下深），增强对比度 -->
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="8" Direction="315" Opacity="0.75"/>
            </Border.Effect>

            <!-- 包裹层：方向性边框 + 主内容 + 顶部高光线 overlay -->
            <Grid Background="Transparent">
                <!-- 左上高光边（受光面 #50A0DC 50%，增强对比度） -->
                <Border BorderBrush="#8050A0DC" BorderThickness="2,2,0,0" CornerRadius="18"/>
                <!-- 右下暗影边（背光面 #000000 70%，增强对比度） -->
                <Border BorderBrush="#B0000000" BorderThickness="0,0,2,2" CornerRadius="18"/>
                <!-- 主内容：单行三栏（左栏固定宽 / 中表盘+状态条 Auto / 右栏固定窄） -->
                <Grid Margin="12,8" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左右蓝色分隔线 -->
                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#664A90E2" Margin="0,4"/>
                    <Border Grid.Column="2" HorizontalAlignment="Left" Width="1" Background="#664A90E2" Margin="0,4"/>

                    <!-- ===== 左栏：航插/脚踏接入 + 错误信息凹槽显示（与右栏对称） ===== -->
                    <Grid Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 航插 + 脚踏（紧凑排列） -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse x:Name="LedAviation" Width="14" Height="14" Fill="#FF9CA3AF"/>
                                <TextBlock Text="航插" Margin="5,0,0,0" Foreground="#FF8A9BB5" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="LedFootPedal" Width="14" Height="14" Fill="#FF9CA3AF"/>
                                <TextBlock Text="脚踏" Margin="5,0,0,0" Foreground="#FF8A9BB5" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 1: 错误信息凹槽 + 描述标签 -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 描述标签（两侧装饰线 + 文字） -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="11"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="11"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="11" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="提示" Foreground="#FF6FA0D8" FontSize="12" Margin="4,0,4,0"/>
                                <Rectangle Grid.Column="2" Width="11" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 凹槽容器（外唇 #333C48 + 暗底 #0C0E13 + 左上阴影 #05070A + 右下高光 #3A4453） -->
                            <Grid Width="66" Height="34" HorizontalAlignment="Center">
                                <Border Background="#FF0C0E13" CornerRadius="5"/>
                                <Border CornerRadius="5" BorderBrush="#FF333C48" BorderThickness="1"/>
                                <Border CornerRadius="5" BorderBrush="#FF05070A" BorderThickness="1,1,0,0"/>
                                <Border CornerRadius="5" BorderBrush="#FF3A4453" BorderThickness="0,0,1,1"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="LedStandby" Width="10" Height="10" Fill="#FF9CA3AF" Visibility="Collapsed"/>
                                    <TextBlock x:Name="LblStandby" Text="" Margin="5,0,0,0" Foreground="#FFE5E7EB" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 中栏：旋转图片 + 数码管 + 状态条（去除表盘） ===== -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                        <!-- 旋转图片 + 数码管容器 -->
                        <Grid Width="150" Height="150">
                            <!-- 旋转图片（转子/风扇，背景透明，正转顺时针/反转逆时针） -->
                            <Image x:Name="RotorImage" Source="SVG/image.png"
                                   Width="60" Height="55" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   RenderTransformOrigin="0.5,0.5" Stretch="Uniform" Margin="0,-5,0,0">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="RotorRotate" Angle="0"/>
                                </Image.RenderTransform>
                            </Image>
                            <!-- 数码管60000 + rpm（双层辉光：外层BR16 Op0.4 + 内层BR8 Op0.9） -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                                <Grid Background="Transparent">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="#FF3FE89A" BlurRadius="14" ShadowDepth="0" Direction="0" Opacity="0.4"/>
                                    </Grid.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.LayoutTransform>
                                            <ScaleTransform ScaleX="0.42" ScaleY="0.42"/>
                                        </StackPanel.LayoutTransform>
                                        <StackPanel.Effect>
                                            <DropShadowEffect Color="#FF3FE89A" BlurRadius="7" ShadowDepth="0" Direction="0" Opacity="0.9"/>
                                        </StackPanel.Effect>
                                        <local:SevenSegmentDigit x:Name="Digit1" Digit="0"/>
                                        <local:SevenSegmentDigit x:Name="Digit2" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit3" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit4" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit5" Digit="0" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <TextBlock Text="速度显示" Foreground="#FF7A9CC8" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Height="22" Width="60" Margin="0,113,0,0"/>
                        </Grid>


                    </StackPanel>

                    <!-- ===== 右栏：3按钮垂直分布占满高度 ===== -->
                    <Grid Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="BtnPower" Width="48" Height="48" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnPower_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="5" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <!-- 主体底色 -->
                                        <Border x:Name="bd" Background="#FF1A2230" CornerRadius="24"/>
                                        <!-- 左上高光边 -->
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1.5,1.5,0,0" CornerRadius="24"/>
                                        <!-- 右下暗影边 -->
                                        <Border BorderBrush="#FF15171C" BorderThickness="0,0,1.5,1.5" CornerRadius="24"/>
                                        <!-- 内容：图标+文字 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <Path x:Name="IconPlay" Data="M8,5.2 L19,12 L8,18.8 Z" Fill="#FF3FA9FF"
                                                          Width="18" Height="18" Stretch="Uniform" Visibility="Visible"/>
                                                <Path x:Name="IconPause" Data="M6.9,5 A1.4,1.4 0 0 0 5.5,6.4 L5.5,17.6 A1.4,1.4 0 0 0 6.9,19 L9.7,19 A1.4,1.4 0 0 0 11.1,17.6 L11.1,6.4 A1.4,1.4 0 0 0 9.7,5 Z M15.3,5 A1.4,1.4 0 0 0 13.9,6.4 L13.9,17.6 A1.4,1.4 0 0 0 15.3,19 L18.1,19 A1.4,1.4 0 0 0 19.5,17.6 L19.5,6.4 A1.4,1.4 0 0 0 18.1,5 Z"
                                                          Fill="#FF3FA9FF" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="LblPower" Grid.Row="1" Text="启动" Foreground="#FFD1D5DB" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF252A36"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background" Value="#FF15191F"/>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Row 1: 设置按钮（单层实体，参考v0.6） -->
                        <Button Grid.Row="1" x:Name="BtnSetSpeed" Width="48" Height="48" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnSetSpeed_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="5" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <Border x:Name="bd" Background="#FF1A2230" CornerRadius="24"/>
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1.5,1.5,0,0" CornerRadius="24"/>
                                        <Border BorderBrush="#FF15171C" BorderThickness="0,0,1.5,1.5" CornerRadius="24"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="M19.74,11.02 L21.56,12.90 L21.18,14.82 L18.78,15.86 L18.16,16.78 L18.12,19.40 L16.49,20.48 L14.06,19.52 L12.98,19.74 L11.10,21.56 L9.18,21.18 L8.14,18.78 L7.22,18.16 L4.60,18.12 L3.52,16.49 L4.48,14.06 L4.26,12.98 L2.44,11.10 L2.82,9.18 L5.22,8.14 L5.84,7.22 L5.88,4.60 L7.51,3.52 L9.94,4.48 L11.02,4.26 L12.90,2.44 L14.82,2.82 L15.86,5.22 L16.78,5.84 L19.40,5.88 L20.48,7.51 L19.52,9.94 Z M15,12 A3,3 0 1 0 9,12 A3,3 0 1 0 15,12 Z"
                                                      Fill="#FF7A8AA0" Width="18" Height="18" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <TextBlock Grid.Row="1" Text="设置" Foreground="#FFD1D5DB" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF252A36"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background" Value="#FF15191F"/>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
                <!-- 顶部高光线：1px 弧段 #2A4A78（面板顶部装饰，独立 overlay） -->
                <Border Height="1" VerticalAlignment="Top" Margin="40,2" CornerRadius="0.5" Panel.ZIndex="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002A4A78" Offset="0"/>
                            <GradientStop Color="#FF2A4A78" Offset="0.5"/>
                            <GradientStop Color="#002A4A78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- 设置弹窗（Popup 可超出窗口边界显示） -->
        <Popup x:Name="SettingsPopup" Placement="Center" PlacementTarget="{Binding ElementName=MainPanel}"
               IsOpen="False" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
        <Border x:Name="SettingsPanel" Width="210" Height="232" CornerRadius="10"
                BorderBrush="Transparent" BorderThickness="1" ClipToBounds="True"
                MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsPanelTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0F1623" Offset="0"/>
                    <GradientStop Color="#0A0F1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Direction="315" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Border BorderBrush="#8050A0DC" BorderThickness="1,1,0,0" CornerRadius="10"/>
                <Border BorderBrush="#B0000000" BorderThickness="0,0,1,1" CornerRadius="10"/>

                <Grid Margin="18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏（可拖动） -->
                    <Border Grid.Row="0" Background="#301A2230" CornerRadius="5" Padding="0,5"
                            MouseLeftButtonDown="PopupHeader_MouseLeftButtonDown"
                            MouseMove="PopupHeader_MouseMove"
                            MouseLeftButtonUp="PopupHeader_MouseLeftButtonUp"
                            Margin="0,0,0,10" Cursor="SizeAll">
                        <TextBlock Text="设置" Foreground="#FF6FA0D8" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 方向标签（两侧装饰线，参考提示框架） -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="方向" Foreground="#FF6FA0D8" FontSize="11" Margin="4,0,4,0"/>
                        <Rectangle Grid.Column="2" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 方向切换（凹槽风格，全宽） -->
                    <Button Grid.Row="2" x:Name="BtnDirToggle" Height="30" Cursor="Hand" Click="BtnDirToggle_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border Background="#FF0C0E13" CornerRadius="5"/>
                                    <Border CornerRadius="5" BorderBrush="#FF333C48" BorderThickness="1"/>
                                    <Border CornerRadius="5" BorderBrush="#FF05070A" BorderThickness="1,1,0,0"/>
                                    <Border x:Name="hl" CornerRadius="5" BorderBrush="#FF3A4453" BorderThickness="0,0,1,1"/>
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                                        <TextBlock x:Name="LblDirToggle" Text="正转" Foreground="#FF3FA9FF" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#40252A36"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 转速标签（两侧装饰线，参考提示框架） -->
                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="转速" Foreground="#FF6FA0D8" FontSize="11" Margin="4,0,4,0"/>
                        <Rectangle Grid.Column="2" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 转速输入（凹槽风格，全宽） -->
                    <Grid Grid.Row="4" Height="30" Margin="0,0,0,10">
                        <Border Background="#FF0C0E13" CornerRadius="5"/>
                        <Border CornerRadius="5" BorderBrush="#FF333C48" BorderThickness="1"/>
                        <Border CornerRadius="5" BorderBrush="#FF05070A" BorderThickness="1,1,0,0"/>
                        <Border CornerRadius="5" BorderBrush="#FF3A4453" BorderThickness="0,0,1,1"/>
                        <Grid>
                            <TextBox x:Name="PopupTxtSpeed" BorderThickness="0" Background="Transparent"
                                     Foreground="#FFFFFFFF" FontSize="13" CaretBrush="#FF3FA9FF"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Text="60000" KeyDown="PopupTxtSpeed_KeyDown"
                                     Margin="6,0,28,0"/>
                            <TextBlock Text="rpm" Foreground="#FF5A8AC0" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                    </Grid>

                    <!-- 确认/取消按钮 -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button x:Name="BtnConfirm" Width="72" Height="28" Cursor="Hand" Click="BtnConfirm_Click" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FF22C55E" CornerRadius="5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.5"/>
                                        </Border.Effect>
                                        <TextBlock Text="确认" Foreground="White" FontSize="11" FontWeight="Medium"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF16A34A"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF15803D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnCancel" Width="72" Height="28" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FFEF4444" CornerRadius="5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.5"/>
                                        </Border.Effect>
                                        <TextBlock Text="取消" Foreground="White" FontSize="11" FontWeight="Medium"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFDC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFB91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Popup>
    </Grid>
</Window>
