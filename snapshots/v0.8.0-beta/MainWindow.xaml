<Window x:Class="HDs2_SDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDs2_SDK"
        mc:Ignorable="d"
        Title="HDs2-SDK" Height="280" Width="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- 画布径向光晕：中心 #141A28 → 边缘 #0A0F1C -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- 面板：圆角18，填充 #0E1422 + 蓝色径向高光，双层描边，柔和投影（按规格 §14） -->
        <Border Width="430" Height="250"
                CornerRadius="18"
                BorderBrush="Transparent"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.45" RadiusY="0.4" Opacity="0.92">
                    <GradientStop Color="#0E1422" Offset="0"/>
                    <GradientStop Color="#0E1422" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <!-- 面板投影：光源左上 → 阴影投向右下（左上浅右下深），增强对比度 -->
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="8" Direction="315" Opacity="0.75"/>
            </Border.Effect>

            <!-- 包裹层：方向性边框 + 主内容 + 顶部高光线 overlay -->
            <Grid>
                <!-- 左上高光边（受光面 #50A0DC 50%，增强对比度） -->
                <Border BorderBrush="#8050A0DC" BorderThickness="2,2,0,0" CornerRadius="18"/>
                <!-- 右下暗影边（背光面 #000000 70%，增强对比度） -->
                <Border BorderBrush="#B0000000" BorderThickness="0,0,2,2" CornerRadius="18"/>
                <!-- 主内容：单行三栏（左栏固定宽 / 中表盘+状态条 Auto / 右栏固定窄） -->
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="97"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="97"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左右蓝色分隔线 -->
                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#664A90E2" Margin="0,8"/>
                    <Border Grid.Column="2" HorizontalAlignment="Left" Width="1" Background="#664A90E2" Margin="0,8"/>

                    <!-- ===== 左栏：3行与右栏对称 ===== -->
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 待机/运行状态指示器（居中，与右栏启动按钮对齐） -->
                        <Border Grid.Row="0" x:Name="StatusStandby" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="8" Width="81" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="40" Width="65">
                                <Ellipse x:Name="LedStandby" Width="15" Height="15" Fill="#FFB0B8C4" Margin="3,0,0,0"/>
                                <TextBlock x:Name="LblStandby" Text="待机" Foreground="#FF8A9BB5" FontSize="17" Margin="6,0,0,0" VerticalAlignment="Center" Height="24" Width="38"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: 高速/低速合一控件（居中，上移8px，与右栏正反转按钮对齐） -->
                        <Border Grid.Row="1" x:Name="StatusSpeedOuter" Background="#FF0E1A2C" CornerRadius="8" Width="81" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Grid>
                                <Border CornerRadius="8" BorderBrush="#FFA0A8B4" BorderThickness="1.2,1.2,0,0"/>
                                <Border x:Name="StatusSpeedBorderBR" CornerRadius="8" BorderBrush="#FFA0A8B4" BorderThickness="0,0,1.2,1.2"/>
                                <Border x:Name="StatusSpeed" Background="Transparent" CornerRadius="8" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="40" Width="65">
                                        <Ellipse x:Name="LedSpeed" Width="15" Height="15" Fill="#FFA0A8B4" RenderTransformOrigin="0.514,0.569" Margin="3,0,0,0"/>
                                        <TextBlock x:Name="LblSpeed" Text="低速" Foreground="#FF8A9BB5" FontSize="17" Margin="6,0,0,0" VerticalAlignment="Center" Height="24" Width="40"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 2: 设定转速（居中，与右栏设置按钮对齐） -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="13"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="13"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="13" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="设定转速" Foreground="#FF6FA0D8" FontSize="10" Margin="5,0"/>
                                <Rectangle Grid.Column="2" Width="13" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Width="81" Height="48" CornerRadius="7" Background="#FF0E1A2C" HorizontalAlignment="Center">
                                <Grid>
                                    <Border CornerRadius="7" BorderBrush="#FF5064A0" BorderThickness="0,1.2,0,0"/>
                                    <Border CornerRadius="7" BorderBrush="#80000000" BorderThickness="0,0,0,1.2"/>
                                    <Rectangle RadiusX="5" RadiusY="5" Margin="2,2,2,2">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#4050A0DC" Offset="0"/>
                                                <GradientStop Color="#1550A0DC" Offset="0.4"/>
                                                <GradientStop Color="#0050A0DC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBox x:Name="TxtSpeed" BorderThickness="0" Background="Transparent"
                                                 Foreground="#FFFFFFFF" FontSize="14"
                                                 CaretBrush="#FF3FA9FF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 Text="60000" KeyDown="TxtSpeed_KeyDown"/>
                                        <TextBlock Text="rpm" Foreground="#FF5A8AC0" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 中栏：表盘 + 表盘正下方状态条 ===== -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                        <!-- 表盘 180×180 -->
                        <Grid Width="180" Height="180">
                            <!-- 表盘Canvas -->
                            <Canvas x:Name="GaugeCanvas" Width="180" Height="180"/>
                            <!-- 旋转图片（转子/风扇，背景透明，正转顺时针/反转逆时针） -->
                            <Image x:Name="RotorImage" Source="SVG/image.png"
                                   Width="46" Height="57" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   RenderTransformOrigin="0.5,0.5" Stretch="Uniform" Margin="0,4,0,0">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.LayoutTransform>
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="RotorRotate" Angle="0"/>
                                </Image.RenderTransform>
                            </Image>
                            <!-- 数码管60000 + rpm（双层辉光：外层BR16 Op0.4 + 内层BR8 Op0.9） -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                                <!-- 外层辉光(大模糊低透明度) -->
                                <Grid Background="Transparent">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="#FF3FE89A" BlurRadius="16" ShadowDepth="0" Direction="0" Opacity="0.4"/>
                                    </Grid.Effect>
                                    <!-- 内层辉光(小模糊高透明度) + 数码管内容 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.LayoutTransform>
                                            <ScaleTransform ScaleX="0.26" ScaleY="0.26"/>
                                        </StackPanel.LayoutTransform>
                                        <StackPanel.Effect>
                                            <DropShadowEffect Color="#FF3FE89A" BlurRadius="8" ShadowDepth="0" Direction="0" Opacity="0.9"/>
                                        </StackPanel.Effect>
                                        <local:SevenSegmentDigit x:Name="Digit1" Digit="0"/>
                                        <local:SevenSegmentDigit x:Name="Digit2" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit3" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit4" Digit="0" Margin="3,0,0,0"/>
                                        <local:SevenSegmentDigit x:Name="Digit5" Digit="0" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <TextBlock Text="rpm" Foreground="#FF7A9CC8" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,130,0,0" Height="16" Width="20"/>
                            <!-- 粒子波纹 Canvas -->
                            <Canvas x:Name="ParticleCanvas" Width="180" Height="180" ClipToBounds="True"/>
                        </Grid>

                        <!-- 状态条：表盘正下方（120×23 小圆角矩形 + 双层辉光，与高速控件一致） -->
                        <Border x:Name="StatusPillOuter" Width="80" Height="18" Background="Transparent"
                                HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border x:Name="StatusPill" CornerRadius="5" Background="#FF0F1A28" BorderBrush="#FF1F3A5C" BorderThickness="1">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 盾牌+对勾(#3FE89A) -->
                                    <Grid Width="11" Height="11" Margin="0,0,4,0">
                                        <Path Data="M12,2.2 L20,5.8 L20,12 C20,16.8 16.6,20.3 12,21.8 C7.4,20.3 4,16.8 4,12 L4,5.8 Z"
                                              Fill="#EB3FE89A" Stretch="Uniform">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#FF3FE89A" BlurRadius="4" ShadowDepth="0" Direction="0" Opacity="0.6"/>
                                            </Path.Effect>
                                        </Path>
                                        <Path Data="M8.6,11.8 L11,14.2 L15.6,9.2" Stroke="#FF0A1628" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock x:Name="LblStatusPill" Text="运行正常" Foreground="#FFE8F0FF" FontSize="10" VerticalAlignment="Center"/>
                                    <Ellipse Width="4" Height="4" Fill="#FF3FE89A" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FF3FE89A" BlurRadius="4" ShadowDepth="0" Direction="0" Opacity="0.6"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- ===== 右栏：3按钮垂直分布占满高度 ===== -->
                    <Grid Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: 启动按钮（单层实体，参考v0.6） -->
                        <Button Grid.Row="0" x:Name="BtnPower" Width="56" Height="56" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnPower_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="6" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <!-- 主体底色 -->
                                        <Border x:Name="bd" Background="#FF1A2230" CornerRadius="28"/>
                                        <!-- 左上高光边 -->
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1.5,1.5,0,0" CornerRadius="28"/>
                                        <!-- 右下暗影边 -->
                                        <Border BorderBrush="#FF15171C" BorderThickness="0,0,1.5,1.5" CornerRadius="28"/>
                                        <!-- 内容：图标+文字 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <Path x:Name="IconPlay" Data="M8,5.2 L19,12 L8,18.8 Z" Fill="#FF3FA9FF"
                                                          Width="18" Height="18" Stretch="Uniform" Visibility="Visible"/>
                                                <Path x:Name="IconPause" Data="M6.9,5 A1.4,1.4 0 0 0 5.5,6.4 L5.5,17.6 A1.4,1.4 0 0 0 6.9,19 L9.7,19 A1.4,1.4 0 0 0 11.1,17.6 L11.1,6.4 A1.4,1.4 0 0 0 9.7,5 Z M15.3,5 A1.4,1.4 0 0 0 13.9,6.4 L13.9,17.6 A1.4,1.4 0 0 0 15.3,19 L18.1,19 A1.4,1.4 0 0 0 19.5,17.6 L19.5,6.4 A1.4,1.4 0 0 0 18.1,5 Z"
                                                          Fill="#FF3FA9FF" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="LblPower" Grid.Row="1" Text="启动" Foreground="#FFD1D5DB" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF252A36"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background" Value="#FF15191F"/>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Row 1: 正反转按钮（单层实体，参考v0.6） -->
                        <Button Grid.Row="1" x:Name="BtnDir" Width="56" Height="56" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnDir_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="6" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <Border x:Name="bd" Background="#FF1A2230" CornerRadius="28"/>
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1.5,1.5,0,0" CornerRadius="28"/>
                                        <Border BorderBrush="#FF15171C" BorderThickness="0,0,1.5,1.5" CornerRadius="28"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <Path x:Name="IconCw" Data="M21,12 A9,9 0 1 1 12,3 C14.52,3 16.93,4 18.74,5.74 L21,8 M21,3 L21,8 L16,8"
                                                          Stroke="#FF3FA9FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Visibility="Visible"/>
                                                <Path x:Name="IconCcw" Data="M3,12 A9,9 0 1 0 12,3 C9.48,3 7.07,4 5.26,5.74 L3,8 M3,3 L3,8 L8,8"
                                                          Stroke="#FF3FA9FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="LblDir" Grid.Row="1" Text="正转" Foreground="#FFD1D5DB" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF252A36"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background" Value="#FF15191F"/>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Row 2: 设置按钮（单层实体，参考v0.6） -->
                        <Button Grid.Row="2" x:Name="BtnSetSpeed" Width="56" Height="56" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnSetSpeed_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="6" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <Border x:Name="bd" Background="#FF1A2230" CornerRadius="28"/>
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1.5,1.5,0,0" CornerRadius="28"/>
                                        <Border BorderBrush="#FF15171C" BorderThickness="0,0,1.5,1.5" CornerRadius="28"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="M19.74,11.02 L21.56,12.90 L21.18,14.82 L18.78,15.86 L18.16,16.78 L18.12,19.40 L16.49,20.48 L14.06,19.52 L12.98,19.74 L11.10,21.56 L9.18,21.18 L8.14,18.78 L7.22,18.16 L4.60,18.12 L3.52,16.49 L4.48,14.06 L4.26,12.98 L2.44,11.10 L2.82,9.18 L5.22,8.14 L5.84,7.22 L5.88,4.60 L7.51,3.52 L9.94,4.48 L11.02,4.26 L12.90,2.44 L14.82,2.82 L15.86,5.22 L16.78,5.84 L19.40,5.88 L20.48,7.51 L19.52,9.94 Z M15,12 A3,3 0 1 0 9,12 A3,3 0 1 0 15,12 Z"
                                                      Fill="#FF7A8AA0" Width="18" Height="18" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <TextBlock Grid.Row="1" Text="设置" Foreground="#FFD1D5DB" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF252A36"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background" Value="#FF15191F"/>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
                <!-- 顶部高光线：1px 弧段 #2A4A78（面板顶部装饰，独立 overlay） -->
                <Border Height="1" VerticalAlignment="Top" Margin="40,2" CornerRadius="0.5" Panel.ZIndex="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002A4A78" Offset="0"/>
                            <GradientStop Color="#FF2A4A78" Offset="0.5"/>
                            <GradientStop Color="#002A4A78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
