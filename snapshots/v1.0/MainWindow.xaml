<Window x:Class="HDs2_SDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDs2_SDK"
        mc:Ignorable="d"
        Title="HDs2-SDK" Height="160" Width="267"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- 面板：钢琴风格横向长条，圆角14，深色渐变底 + 双层描边 + 柔和投影 -->
        <Border x:Name="MainPanel" Width="370" Height="210"
                CornerRadius="14"
                BorderBrush="Transparent"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ClipToBounds="True"
                RenderOptions.ClearTypeHint="Enabled"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="0.6667" ScaleY="0.6667"/>
            </Border.LayoutTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#11151E" Offset="0"/>
                    <GradientStop Color="#0A0E16" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="8" Direction="315" Opacity="0.75"/>
            </Border.Effect>

            <Grid Background="Transparent">
                <!-- 左上高光边 -->
                <Border BorderBrush="#8050A0DC" BorderThickness="1.5,1.5,0,0" CornerRadius="14"/>
                <!-- 右下暗影边 -->
                <Border BorderBrush="#B0000000" BorderThickness="0,0,1.5,1.5" CornerRadius="14"/>

                <!-- 主内容：上下两行（上部显示区横向拉伸 / 下部钢琴键控制栏） -->
                <Grid Margin="10,8,10,6" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <!-- ===== 上部：横向拉伸显示区（旋转图片 + 数码管） ===== -->
                    <Grid Grid.Row="0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：旋转图片 -->
                        <Image Grid.Column="0" x:Name="RotorImage" Source="SVG/image.png"
                               Width="75" Height="75" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5" Stretch="Uniform" Margin="8,0,6,0">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="RotorRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- 右：数码管横向拉伸居中 -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 数码管60000（无背景辉光） -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                </StackPanel.LayoutTransform>
                                <local:SevenSegmentDigit x:Name="Digit1" Digit="0"/>
                                <local:SevenSegmentDigit x:Name="Digit2" Digit="0" Margin="3,0,0,0"/>
                                <local:SevenSegmentDigit x:Name="Digit3" Digit="0" Margin="3,0,0,0"/>
                                <local:SevenSegmentDigit x:Name="Digit4" Digit="0" Margin="3,0,0,0"/>
                                <local:SevenSegmentDigit x:Name="Digit5" Digit="0" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== 下部：钢琴键风格控制栏（启动 | 设置） ===== -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左下：启动按钮（钢琴键风格） -->
                        <Button Grid.Column="0" x:Name="BtnPower" Height="40" Cursor="Hand" Click="BtnPower_Click"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,5,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="4" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <!-- 主体：顶部高光渐变 -->
                                        <Border x:Name="bd" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#FF222A38" Offset="0"/>
                                                    <GradientStop Color="#FF1A2230" Offset="0.15"/>
                                                    <GradientStop Color="#FF15191F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- 顶部钢琴键高光带 -->
                                        <Border x:Name="powerHl" Height="6" VerticalAlignment="Top" CornerRadius="10,10,0,0" ClipToBounds="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#8060A8E0" Offset="0"/>
                                                    <GradientStop Color="#0060A8E0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- 左上高光边 -->
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1,1,0,0" CornerRadius="10"/>
                                        <!-- 右下暗影边 -->
                                        <Border BorderBrush="#FF0A0C10" BorderThickness="0,0,1,1" CornerRadius="10"/>
                                        <!-- 内容：图标+文字水平排列 -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Path x:Name="IconPlay" Data="M8,5.2 L19,12 L8,18.8 Z" Fill="#FF3FA9FF"
                                                      Width="18" Height="18" Stretch="Uniform" Visibility="Visible"/>
                                                <Path x:Name="IconPause" Data="M6.9,5 A1.4,1.4 0 0 0 5.5,6.4 L5.5,17.6 A1.4,1.4 0 0 0 6.9,19 L9.7,19 A1.4,1.4 0 0 0 11.1,17.6 L11.1,6.4 A1.4,1.4 0 0 0 9.7,5 Z M15.3,5 A1.4,1.4 0 0 0 13.9,6.4 L13.9,17.6 A1.4,1.4 0 0 0 15.3,19 L18.1,19 A1.4,1.4 0 0 0 19.5,17.6 L19.5,6.4 A1.4,1.4 0 0 0 18.1,5 Z"
                                                      Fill="#FF3FA9FF" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock x:Name="LblPower" Text="启动" Foreground="#FFD1D5DB" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF2A3344" Offset="0"/>
                                                        <GradientStop Color="#FF222A38" Offset="0.15"/>
                                                        <GradientStop Color="#FF1A1F28" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF15191F" Offset="0"/>
                                                        <GradientStop Color="#FF10141A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="2" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 右下：设置按钮（钢琴键风格） -->
                        <Button Grid.Column="1" x:Name="BtnSetSpeed" Height="40" Cursor="Hand" Click="BtnSetSpeed_Click"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Effect>
                                            <DropShadowEffect Color="#66000000" BlurRadius="4" ShadowDepth="2" Direction="90" Opacity="0.6"/>
                                        </Grid.Effect>
                                        <Border x:Name="bd" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#FF222A38" Offset="0"/>
                                                    <GradientStop Color="#FF1A2230" Offset="0.15"/>
                                                    <GradientStop Color="#FF15191F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Height="6" VerticalAlignment="Top" CornerRadius="10,10,0,0" ClipToBounds="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#807A8AA0" Offset="0"/>
                                                    <GradientStop Color="#007A8AA0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border BorderBrush="#FF4A525C" BorderThickness="1,1,0,0" CornerRadius="10"/>
                                        <Border BorderBrush="#FF0A0C10" BorderThickness="0,0,1,1" CornerRadius="10"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M19.74,11.02 L21.56,12.90 L21.18,14.82 L18.78,15.86 L18.16,16.78 L18.12,19.40 L16.49,20.48 L14.06,19.52 L12.98,19.74 L11.10,21.56 L9.18,21.18 L8.14,18.78 L7.22,18.16 L4.60,18.12 L3.52,16.49 L4.48,14.06 L4.26,12.98 L2.44,11.10 L2.82,9.18 L5.22,8.14 L5.84,7.22 L5.88,4.60 L7.51,3.52 L9.94,4.48 L11.02,4.26 L12.90,2.44 L14.82,2.82 L15.86,5.22 L16.78,5.84 L19.40,5.88 L20.48,7.51 L19.52,9.94 Z M15,12 A3,3 0 1 0 9,12 A3,3 0 1 0 15,12 Z"
                                                  Fill="#FF7A8AA0" Width="18" Height="18" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="设置" Foreground="#FFD1D5DB" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF2A3344" Offset="0"/>
                                                        <GradientStop Color="#FF222A38" Offset="0.15"/>
                                                        <GradientStop Color="#FF1A1F28" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="2"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF15191F" Offset="0"/>
                                                        <GradientStop Color="#FF10141A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="root" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#66000000" BlurRadius="2" ShadowDepth="1" Direction="90" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 顶部高光线 -->
                <Border Height="1" VerticalAlignment="Top" Margin="30,2" CornerRadius="0.5" Panel.ZIndex="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002A4A78" Offset="0"/>
                            <GradientStop Color="#FF2A4A78" Offset="0.5"/>
                            <GradientStop Color="#002A4A78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- 设置弹窗（Popup 可超出窗口边界显示） -->
        <Popup x:Name="SettingsPopup" Placement="Center" PlacementTarget="{Binding ElementName=MainPanel}"
               IsOpen="False" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border x:Name="SettingsPanel" Width="210" Height="232" CornerRadius="10"
                BorderBrush="Transparent" BorderThickness="1" ClipToBounds="True"
                MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="0.6667" ScaleY="0.6667"/>
                </Border.LayoutTransform>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsPanelTransform" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#0F1623" Offset="0"/>
                        <GradientStop Color="#0A0F1A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Direction="315" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Border BorderBrush="#8050A0DC" BorderThickness="1,1,0,0" CornerRadius="10"/>
                    <Border BorderBrush="#B0000000" BorderThickness="0,0,1,1" CornerRadius="10"/>

                    <Grid Margin="18,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 标题栏（可拖动） -->
                        <Border Grid.Row="0" Background="#301A2230" CornerRadius="5" Padding="0,5"
                            MouseLeftButtonDown="PopupHeader_MouseLeftButtonDown"
                            MouseMove="PopupHeader_MouseMove"
                            MouseLeftButtonUp="PopupHeader_MouseLeftButtonUp"
                            Margin="0,0,0,10" Cursor="SizeAll">
                            <TextBlock Text="设置" Foreground="#FF6FA0D8" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        </Border>

                        <!-- 方向标签（两侧装饰线，参考提示框架） -->
                        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="方向" Foreground="#FF6FA0D8" FontSize="11" Margin="4,0,4,0"/>
                            <Rectangle Grid.Column="2" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 方向切换（凹槽风格，全宽） -->
                        <Button Grid.Row="2" x:Name="BtnDirToggle" Height="30" Cursor="Hand" Click="BtnDirToggle_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border Background="#FF0C0E13" CornerRadius="5"/>
                                        <Border CornerRadius="5" BorderBrush="#FF333C48" BorderThickness="1"/>
                                        <Border CornerRadius="5" BorderBrush="#FF05070A" BorderThickness="1,1,0,0"/>
                                        <Border x:Name="hl" CornerRadius="5" BorderBrush="#FF3A4453" BorderThickness="0,0,1,1"/>
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                                            <TextBlock x:Name="LblDirToggle" Text="正转" Foreground="#FF3FA9FF" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#40252A36"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 转速标签（两侧装饰线，参考提示框架） -->
                        <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="转速" Foreground="#FF6FA0D8" FontSize="11" Margin="4,0,4,0"/>
                            <Rectangle Grid.Column="2" Width="14" Height="1" Fill="#FF5A8AC0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 转速调节（凹槽风格：[-] 值 rpm [+]），短按=单步，长按=连续增减 -->
                        <Grid Grid.Row="4" Height="30" Margin="0,0,0,10">
                            <Border Background="#FF0C0E13" CornerRadius="5"/>
                            <Border CornerRadius="5" BorderBrush="#FF333C48" BorderThickness="1"/>
                            <Border CornerRadius="5" BorderBrush="#FF05070A" BorderThickness="1,1,0,0"/>
                            <Border CornerRadius="5" BorderBrush="#FF3A4453" BorderThickness="0,0,1,1"/>
                            <Grid>
                                <!-- 直接输入转速（回车确认，失焦校验） -->
                                <Grid>
                                    <TextBox x:Name="PopupTxtSpeed" Text="60000"
                                             Foreground="#FFFFFFFF" Background="#FF1A2230"
                                             BorderBrush="#FF333C48" BorderThickness="1"
                                             FontSize="13" FontFamily="Microsoft YaHei UI"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Height="28" MaxLength="5"
                                             PreviewTextInput="PopupTxtSpeed_PreviewTextInput"
                                             KeyDown="PopupTxtSpeed_KeyDown"
                                             LostFocus="PopupTxtSpeed_LostFocus"/>
                                    <TextBlock Text="rpm" Foreground="#FF5A8AC0" FontSize="9"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Margin="0,0,6,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 确认/取消按钮 -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button x:Name="BtnConfirm" Width="72" Height="28" Cursor="Hand" Click="BtnConfirm_Click" Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FF22C55E" CornerRadius="5">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.5"/>
                                            </Border.Effect>
                                            <TextBlock Text="确认" Foreground="White" FontSize="11" FontWeight="Medium"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF16A34A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF15803D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnCancel" Width="72" Height="28" Cursor="Hand" Click="BtnCancel_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFEF4444" CornerRadius="5">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#66000000" BlurRadius="3" ShadowDepth="1" Direction="90" Opacity="0.5"/>
                                            </Border.Effect>
                                            <TextBlock Text="取消" Foreground="White" FontSize="11" FontWeight="Medium"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFDC2626"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFB91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
