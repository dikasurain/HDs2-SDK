<UserControl x:Class="HDs2_SDK.SevenSegmentDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="50">
    <UserControl.Resources>
        <Style TargetType="Polygon">
            <Setter Property="Fill" Value="#FF3FE89A"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF3FE89A" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Canvas Width="50" Height="90" ClipToBounds="True">
        <!-- A 顶部横段 -->
        <Polygon x:Name="SegA" Points="2,0 28,0 30,4 28,8 2,8 0,4" Canvas.Left="10" Canvas.Top="0"/>
        <!-- B 右上竖段 -->
        <Polygon x:Name="SegB" Points="0,2 4,0 8,2 8,29 4,31 0,29" Canvas.Left="42" Canvas.Top="10"/>
        <!-- C 右下竖段 -->
        <Polygon x:Name="SegC" Points="0,2 4,0 8,2 8,29 4,31 0,29" Canvas.Left="42" Canvas.Top="49"/>
        <!-- D 底部横段 -->
        <Polygon x:Name="SegD" Points="2,0 28,0 30,4 28,8 2,8 0,4" Canvas.Left="10" Canvas.Top="82"/>
        <!-- E 左下竖段 -->
        <Polygon x:Name="SegE" Points="0,2 4,0 8,2 8,29 4,31 0,29" Canvas.Left="0" Canvas.Top="49"/>
        <!-- F 左上竖段 -->
        <Polygon x:Name="SegF" Points="0,2 4,0 8,2 8,29 4,31 0,29" Canvas.Left="0" Canvas.Top="10"/>
        <!-- G 中间横段 -->
        <Polygon x:Name="SegG" Points="2,0 28,0 30,4 28,8 2,8 0,4" Canvas.Left="10" Canvas.Top="41"/>
    </Canvas>
</UserControl>
