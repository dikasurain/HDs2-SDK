<Window x:Class="HDs2_SDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDs2_SDK"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- 圆形金属实体按键样式 -->
        <Style x:Key="EntityButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect Color="#55000000" BlurRadius="5" ShadowDepth="2" Opacity="0.7"/>
                            </Grid.Effect>
                            <!-- 金属主体 -->
                            <Ellipse x:Name="bd" Stroke="#66000000" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                                        <GradientStop Color="#FFD6DADF" Offset="0"/>
                                        <GradientStop Color="#FFACB2B8" Offset="0.6"/>
                                        <GradientStop Color="#FF737A82" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- 内圈高光 -->
                            <Ellipse Stroke="#88FFFFFF" StrokeThickness="1" Margin="3" Fill="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- 中间磨砂圆角面板 -->
        <Border Width="400" Height="300"
                CornerRadius="20"
                Background="#66FFFFFF"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#22000000"
                                  BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.8"/>
            </Border.Effect>
            <Grid Margin="16,20,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：状态靠左，分隔线靠右（贴近表盘） -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,3" Height="22">
                            <Ellipse x:Name="LedFault" Width="20" Height="20" Fill="#9CA3AF"/>
                            <TextBlock Text="故障" Margin="6,0,0,0" Foreground="#444" FontSize="20" VerticalAlignment="Center" Width="54" Height="27"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3" Height="22">
                            <Ellipse x:Name="LedOverload" Width="20" Height="20" Fill="#9CA3AF"/>
                            <TextBlock Text="过载" Margin="6,0,0,0" Foreground="#444" FontSize="20" VerticalAlignment="Center" Width="54" Height="27"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3" Height="22">
                            <Ellipse x:Name="LedRun" Width="20" Height="20" Fill="#22C55E"/>
                            <TextBlock Text="运行" Margin="6,0,0,0" Foreground="#444" FontSize="20" VerticalAlignment="Center" Width="54" Height="27"/>
                        </StackPanel>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Width="1" Height="96" Background="#664A90E2"/>
                </Grid>

                <!-- 中：表盘 + 数码管（始终居中） -->
                <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center" Margin="14,0">
                    <Canvas x:Name="GaugeCanvas" Width="150" Height="150"/>
                    <!-- 数码管深色底板，提升绿色对比度 -->
                    <Border Width="116" Height="42" CornerRadius="10" Background="#FF0A1A0E"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.LayoutTransform>
                            <ScaleTransform ScaleX="0.38" ScaleY="0.38"/>
                        </StackPanel.LayoutTransform>
                        <local:SevenSegmentDigit x:Name="Digit1" Digit="0"/>
                        <local:SevenSegmentDigit x:Name="Digit2" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit3" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit4" Digit="0" Margin="8,0,0,0"/>
                        <local:SevenSegmentDigit x:Name="Digit5" Digit="0" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 右：分隔线靠左（贴近表盘），胶囊靠右 -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="1" Height="96" Background="#664A90E2"/>
                    <!-- 正反 / 高低 胶囊 -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 正反胶囊 -->
                        <Border Height="26" Width="58" CornerRadius="13" Background="#22000000" Padding="2" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DirForwardCell" Grid.Column="0" CornerRadius="11,0,0,11" Background="#4A90E2">
                                    <TextBlock Text="正" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DirReverseCell" Grid.Column="1" CornerRadius="0,11,11,0">
                                    <TextBlock Text="反" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 高低胶囊 -->
                        <Border Height="26" Width="58" CornerRadius="13" Background="#22000000" Padding="2" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SpeedHighCell" Grid.Column="0" CornerRadius="11,0,0,11" Background="#4A90E2">
                                    <TextBlock Text="高" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="SpeedLowCell" Grid.Column="1" CornerRadius="0,11,11,0">
                                    <TextBlock Text="低" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 分界线 -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#334A90E2" Margin="0,14"/>

                <!-- 底部：4 个圆形实体按键 + 插口识别光环 -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button x:Name="BtnStart" Style="{StaticResource EntityButton}" Content="启"/>
                    <Button x:Name="BtnStop" Style="{StaticResource EntityButton}" Content="停"/>
                    <Button x:Name="BtnSpeedUp" Style="{StaticResource EntityButton}" Content="加"/>
                    <Button x:Name="BtnSpeedDown" Style="{StaticResource EntityButton}" Content="减"/>
                    <!-- 插口识别光环（实体接口样式） -->
                    <Grid Width="34" Height="34" Margin="16,0,0,0" VerticalAlignment="Center">
                        <!-- 金属接口外圈 -->
                        <Ellipse Stroke="#66000000" StrokeThickness="1">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#FFD6DADF" Offset="0"/>
                                    <GradientStop Color="#FFACB2B8" Offset="0.7"/>
                                    <GradientStop Color="#FF737A82" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- 内孔（深色） -->
                        <Ellipse Margin="5" Fill="#FF14110C"/>
                        <!-- 光环指示：接入绿 / 未接入灰 -->
                        <Ellipse x:Name="LedPort" Margin="3" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="3"/>
                        <TextBlock Text="插口" Margin="0,40,0,0" Foreground="#444" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
